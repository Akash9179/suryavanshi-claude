{
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(DROP *)",
      "Bash(truncate *)",
      "mcp__claude-in-chrome__*"
    ],
    "defaultMode": "auto"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "andrej-karpathy-skills@karpathy-skills": false,
    "swift-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "typesafe@typesafe-ai": true
  },
  "skillOverrides": {
    "autoplan": "off",
    "benchmark": "off",
    "benchmark-models": "off",
    "canary": "off",
    "careful": "off",
    "codex": "off",
    "connect-chrome": "off",
    "context-restore": "off",
    "context-save": "off",
    "cso": "off",
    "design-consultation": "off",
    "design-html": "off",
    "devex-review": "off",
    "diagram": "off",
    "document-generate": "off",
    "document-release": "off",
    "freeze": "off",
    "graphify": "off",
    "guard": "off",
    "health": "off",
    "investigate": "off",
    "ios-clean": "off",
    "ios-design-review": "off",
    "ios-fix": "off",
    "ios-qa": "off",
    "ios-sync": "off",
    "land-and-deploy": "off",
    "landing-report": "off",
    "learn": "off",
    "open-gstack-browser": "off",
    "pair-agent": "off",
    "plan-ceo-review": "off",
    "plan-design-review": "off",
    "plan-devex-review": "off",
    "plan-eng-review": "off",
    "plan-tune": "off",
    "qa-only": "off",
    "retro": "off",
    "review": "off",
    "scrape": "off",
    "setup-deploy": "off",
    "setup-gbrain": "off",
    "ship": "off",
    "skillify": "off",
    "sync-gbrain": "off",
    "unfreeze": "off"
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    },
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    }
  },
  "effortLevel": "high",
  "skipWorkflowUsageWarning": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/suryavanshi-claude/sync.sh >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}
